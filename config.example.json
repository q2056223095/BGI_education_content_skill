{
  "project": "bgi-education-content",
  "version": "1.1.0",
  "github": {
    "repository": "q2056223095/BGI_education_content_skill",
    "branch": "main"
  },
  "account_positioning": "生命科学教育与人才培养观察",
  "timezone": "Asia/Bangkok",
  "weekly_target_min": 3,
  "weekly_target_max": 5,
  "images_per_topic": 2,
  "image_size_px": [
    1080,
    1440
  ],
  "image_format": "PNG",
  "unattended": true,
  "max_image_retries": 2,
  "google_drive": {
    "root_folder_id": null,
    "comment": "请填入新的教育内容交付目录ID；不得默认沿用科研热点目录"
  },
  "publish_to_social_platform": false,
  "image_quality_gate": {
    "deterministic_text_overlay_required": true,
    "p1_requires": [
      "title",
      "subtitle",
      "source_label"
    ],
    "p2_requires": [
      "title",
      "points>=2",
      "source_label"
    ],
    "require_manifest_and_qa": true,
    "require_visual_semantic_review": true,
    "fail_closed": true,
    "render_script": "scripts/render_and_validate.py",
    "batch_gate": "scripts/verify_batch.py"
  }
}
