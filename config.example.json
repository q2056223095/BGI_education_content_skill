{
  "project": "bgi-education-content",
  "version": "1.2.0",
  "github": {
    "repository": "q2056223095/BGI_education_content_skill",
    "branch": "main"
  },
  "account_positioning": "生命科学教育与人才培养观察",
  "timezone": "Asia/Bangkok",
  "weekly_target_min": 3,
  "weekly_target_max": 5,
  "images_per_topic": 2,
  "image_size_px": [
    1080,
    1440
  ],
  "image_format": "PNG",
  "unattended": true,
  "max_image_retries": 2,
  "google_drive": {
    "root_folder_id": null,
    "comment": "请填入新的教育内容交付目录ID；不得默认沿用科研热点目录"
  },
  "publish_to_social_platform": false,
  "image_quality_gate": {
    "visual_content_review_required": true,
    "verify_dimensions": true,
    "verify_single_page": true,
    "verify_no_news_details": true,
    "verify_no_misleading_real_scene": true,
    "verify_title_p1": true,
    "verify_no_fake_logo": true,
    "fail_closed": true,
    "manual_or_model_review_log": "图片验收.md"
  },
  "image_generation": {
    "provider": "GPT image generation model",
    "final_image_generated_entirely_by_gpt": true,
    "postprocess_text_overlay_allowed": false,
    "news_details_in_image_allowed": false,
    "p1": {
      "requires_short_title": true,
      "optional_short_subtitle": true,
      "detail_list_allowed": false
    },
    "p2": {
      "short_hook_optional": true,
      "can_be_text_free": true,
      "detail_list_allowed": false
    },
    "max_generation_retries_per_image": 2
  }
}
